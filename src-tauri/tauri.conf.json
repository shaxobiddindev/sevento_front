{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sevento",
  "mainBinaryName": "sevento",
  "version": "../package.json",
  "identifier": "uz.sevento.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sevento",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:8000",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "publisher": "Sevento",
    "copyright": "© 2026 Sevento",
    "shortDescription": "Savdo, ombor, nasiya va kassa",
    "longDescription": "Bir nechta savdo nuqtasi uchun savdo (POS), ombor, kirim, nasiya, kassa va hisobotlar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "office" }
    }
  }
}
