# Nusxa oling: cp .env.example .env

# API manzili. Bo'sh qoldirilsa — joriy sayt (dev da Vite proxy, prod da Nginx) orqali /api/v1
VITE_API_URL=
# WebSocket manzili. Bo'sh — joriy sayt orqali /ws/v1/
VITE_WS_URL=

# Faqat `npm run dev` uchun: /api va /ws so'rovlari qayerga proxy qilinadi
VITE_PROXY_TARGET=http://localhost:8000

# `npm run gen:api` manbasi (fayl yoki URL). Default: ../sevento_back/docs/api/openapi.yaml
# OPENAPI_URL=http://localhost:8000/api/v1/schema/
